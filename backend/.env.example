# --- LLM provider (any provider supported by LangChain's init_chat_model) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5          # default for anthropic; e.g. claude-sonnet-5-5 to reduce cost
# LLM_FAST_MODEL=                    # optional cheaper model for routing + explanations
# LLM_EFFORT=medium                  # Claude effort / Gemini 3+ thinking_level / Groq reasoning_effort for SQL generation/debug/optimization
# LLM_FAST_EFFORT=low                # Claude effort / Gemini 3+ thinking_level / Groq reasoning_effort for routing + explanations

# OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4.1

# Google Gemini instead (free tier: create a key at https://aistudio.google.com/apikey):
# LLM_PROVIDER=gemini                # alias for google_genai
# GEMINI_API_KEY=                    # GOOGLE_API_KEY also works
# LLM_MODEL=gemini-3.8-flash         # default for gemini
# LLM_FAST_MODEL=gemini-3.5-flash-lite  # default for gemini; free-tier quotas are per model

# Groq instead (free tier: create a key at https://console.groq.com/keys):
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b      # default for groq
# LLM_FAST_MODEL=openai/gpt-oss-20b  # default for groq; free-tier limits are per model
# Note: Groq's free tier allows 8K tokens/min and 200K tokens/day per model: roughly 2-3 questions/min
# and ~60 questions/day on the main model. LLM_EFFORT=low cuts reasoning tokens if you hit the limit.

# --- Agent / API ---
# MAX_SQL_ATTEMPTS=3
# MAX_RESULT_ROWS=200
# QUERY_TIMEOUT_S=5
# RATE_LIMIT_PER_MINUTE=20
# TRUSTED_PROXY_HOPS=0             # set to 1 behind a single reverse proxy (e.g. Render)
